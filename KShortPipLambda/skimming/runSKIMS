#!/usr/bin/env bash
set -euo pipefail

SIF="/w/halld-scshelf2101/lng/WORK/PyAmpTools9/pyamptools.sif"
BIND="/volatile/halld/home/dbarton,/cache/halld/home/dbarton,/work/halld/home/dbarton/gluex,/scratch"
WORKDIR="/work/halld/home/dbarton/gluex/KShortPipLambda"
LOGFILE="$WORKDIR/skimLOG.txt"

# ------------------------------------------------------------
# If not already running in background, re-launch with nohup
# ------------------------------------------------------------
if [[ "${RUNSKIMS_NOHUP:-0}" != "1" ]]; then
    echo "Starting runSKIMS in background..."
    echo "Log file: $LOGFILE"

    export RUNSKIMS_NOHUP=1
    nohup "$0" "$@" > "$LOGFILE" 2>&1 &

    disown
    exit 0
fi

# ------------------------------------------------------------
# Actual work starts here (background process)
# ------------------------------------------------------------
echo "=================================================="
echo "runSKIMS started: $(date)"
echo "Host: $(hostname)"
echo "Working dir: $WORKDIR"
echo "=================================================="

apptainer exec --contain --writable-tmpfs -B "$BIND" --env BASH_ENV=/dev/null "$SIF" \
  bash -lc "cd '$WORKDIR'; source /etc/bash.bashrc; python3 -u skim_kStar.py; sync; sleep 0.1"

status=$?

echo "=================================================="
echo "runSKIMS finished: $(date)"
echo "Exit status: $status"
echo "=================================================="

exit $status
