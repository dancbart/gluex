#!/usr/bin/env bash
set -e

# ----- USER INPUT -----
if [ -z "$1" ]; then
	echo "Usage:"
	echo "  makeSDME_from_zlm path/to/fitFolder1/ [path/to/fitFolder2/ ...]"
	echo
	echo "Each folder holds the randomized restarts (*.fit) for one t-bin."
	echo "The best converged fit is used; results go to <folder>/sdme_from_zlm.csv"
	exit 1
fi

# Resolve folder args to absolute paths against your real cwd,
# so relative names work regardless of where the container cd's to.
resolved=()
for a in "$@"; do
  if [[ ! -d "$a" ]]; then
    echo "ERROR: not a folder: $a"
    exit 1
  fi
  resolved+=("$(readlink -f -- "$a")")
done
set -- "${resolved[@]}"
# Log everything printed from here on (stdout + stderr) to the run directory
exec > >(tee "$PWD/sdme_from_zlm_combined.out") 2>&1

SIF="/work/halld/home/dbarton/software/PyAmpTools/pyamptools.sif"
BIND="/volatile/halld/home/dbarton,/cache/halld/home/dbarton,/work/halld/home/dbarton/gluex,/w/halld-scshelf2101/home/dbarton/gluex,/scratch"
WORKDIR="/work/halld/home/dbarton/gluex/KShortPipLambda/PWA"
SCRIPT="sdme_from_zlm.py"   # must be in $WORKDIR

apptainer exec --contain --writable-tmpfs -B "$BIND" --env BASH_ENV=/dev/null "$SIF" \
  bash -lc '
    cd "'"$WORKDIR"'"; source /etc/bash.bashrc
    for d in "$@"; do
      echo "########## $d"
      shopt -s nullglob
      fits=("$d"/*.fit)
      if [ ${#fits[@]} -eq 0 ]; then
        echo "  no .fit files, skipping"
        continue
      fi
      python3 '"$SCRIPT"' --best --csv "$d/sdme_from_zlm.csv" "${fits[@]}" \
        || echo "  FAILED for $d"
    done
    sync
  ' _ "$@"

# ----- Combine per-folder CSVs into one file in the directory this was run from -----
COMBINED="$PWD/sdme_from_zlm_combined.csv"
header_written=0
: > "$COMBINED"
for d in "$@"; do
  csv="$d/sdme_from_zlm.csv"
  [[ -f "$csv" ]] || { echo "no CSV in $d (skipped in combined file)"; continue; }
  if [[ $header_written -eq 0 ]]; then
    echo "folder,$(head -n 1 "$csv")" >> "$COMBINED"
    header_written=1
  fi
  tail -n +2 "$csv" | sed "s|^|$(basename "$d"),|" >> "$COMBINED"
done

if [[ $header_written -eq 1 ]]; then
  echo "Combined CSV: $COMBINED"
else
  rm -f "$COMBINED"
  echo "No per-folder CSVs found; combined file not written"
fi