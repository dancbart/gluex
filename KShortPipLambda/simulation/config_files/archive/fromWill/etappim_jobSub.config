RCDB_QUERY=@is_dirc_production and @status_approved

TAG=etaprimepim

DATA_OUTPUT_BASE_DIR=/u/home/wimoehl/files/etaprimepim/SIGMC/

NCORES=4      # Number of CPU threads to use or nodes:node-id:ppn or nodes:ppn depending on your system

GENERATOR=gen_amp_V2 #or you may specifile file:/.../file-to-use.hddm
GENERATOR_CONFIG=/u/home/wimoehl/SIGMC/CONFIG/etappim_genampv2.cfg
GENERATOR_POSTPROCESS=decay_evtgen:/u/home/wimoehl/SIGMC/CONFIG/userDecay.dec

GEN_MIN_ENERGY=8.0
GEN_MAX_ENERGY=8.6

GEANT_VERSION=4
NOSECONDARIES=0

BKG=Random:recon-2019_11-ver01.2 #[None, Random:[TAG], BeamPhotons, TagOnly, custom e.g bg.hddm:1.8] Can be stacked eg Random:[TAG]+TagOnly:.123 where the :[num] defines BGRATE

ANA_ENVIRONMENT_FILE=/group/halld/www/halldweb/html/halld_versions/analysis-2019_11-ver09.xml

#optional additional plugins that will be run along side danarest and hd_root.  This should be a comma separated list (e.g. plugin1,plugin2)
CUSTOM_PLUGINS=file:/u/home/wimoehl/SIGMC/CONFIG/jana_pi1Search.config
#====================================================================================
#EVERYTHING BELOW FOR BATCH ONLY

VERBOSE=True
BATCH_SYSTEM=swif2#swif2cont #SWIF2cont#qsub #can be swif2 or condor or osg or qsub adding :[name] will pass -q [name] into PBS. 

WORKFLOW_NAME = etapim

#environment file location
ENVIRONMENT_FILE=/group/halld/www/halldweb/html/halld_versions/version.xml

Partition = production

# RESOURCES for swif2 jobs
DISK=4GB            # Max Disk usage
RAM=4GB            # Max RAM usage
TIMELIMIT=4h      # Max walltime.  This may be of the form xx:xx:xx depending on your system
OS=el9        # Specify CentOS65 machines

